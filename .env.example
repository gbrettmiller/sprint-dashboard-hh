# Copy to .env and fill in your values. .env is git-ignored (see .gitignore's
# `*.env` pattern) and is loaded automatically by scripts/gitlab_api.py via
# python-dotenv, so the issue_*.py scripts work without re-exporting env vars
# every session.

# GitLab instance. Defaults to https://gitlab.com if unset.
GITLAB_URL=https://gitlab.com

# Personal access token. read_api scope for read-only scripts (issue_read.py,
# issue_list.py); api scope for write scripts (issue_create.py, issue_update.py,
# issue_comment.py, issue_close.py, issue_implement.py).
GITLAB_TOKEN=your-personal-access-token

# Default project for the issue_*.py scripts. Numeric ID or url-encoded path
# both work — for this repo, gbrettmiller/sprint-dashboard.
GITLAB_PROJECT=gbrettmiller/sprint-dashboard

# Optional: enables `issue_implement.py --assign-to-me`.
# GITLAB_USERNAME=your-username

# Optional: overrides GITLAB_TOKEN for issue metadata scripts only (issue_read,
# issue_list, issue_create, issue_comment, issue_update, issue_close). Not
# needed for this demo repo — only relevant when reading issues from a
# different project/group than the one GITLAB_TOKEN is scoped to.
# GITLAB_ISSUE_TOKEN=
